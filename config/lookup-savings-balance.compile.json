{
  "schemaVersion": 1,
  "id": "lookup_savings_balance",
  "version": "1.0.0",
  "name": "Look up a member savings balance",
  "description": "Search for a member, open their savings account, and return the current balance.",
  "compatibility": {
    "appFamily": "northstar_mock_bank",
    "appVersion": "1.x",
    "entryPath": "/start",
    "requiredMarkers": ["Member Search", "Savings Account"]
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "description": "Five-digit member identifier",
      "pattern": "^[0-9]{5}$",
      "sensitive": true,
      "invalidOutcomeCode": "INVALID_MEMBER_ID"
    }
  },
  "outputs": {
    "balance": {
      "type": "money",
      "description": "Current savings balance",
      "currency": "USD",
      "sensitive": true
    }
  },
  "stepReviews": [
    {
      "id": "enter_member_id",
      "description": "Enter the invocation's member ID on Member Search",
      "risk": "reversible"
    },
    {
      "id": "search_member",
      "description": "Submit the member search",
      "risk": "reversible",
      "after": {
        "kind": "visible",
        "target": { "candidates": [{ "kind": "role", "role": "heading", "name": "Search Results" }] }
      }
    },
    {
      "id": "open_member",
      "description": "Open the matching member record",
      "risk": "read_only",
      "after": {
        "kind": "visible",
        "target": { "candidates": [{ "kind": "role", "role": "heading", "name": "Member Details" }] }
      }
    },
    {
      "id": "open_savings",
      "description": "Open the member's savings account",
      "risk": "read_only",
      "after": {
        "kind": "visible",
        "target": { "candidates": [{ "kind": "role", "role": "heading", "name": "Savings Account" }] }
      }
    },
    {
      "id": "read_balance",
      "description": "Read the current balance from the savings details frame",
      "risk": "read_only",
      "output": "balance",
      "parser": "money"
    }
  ],
  "success": {
    "kind": "visible",
    "target": {
      "frame": { "title": "Savings account details" },
      "candidates": [{ "kind": "role", "role": "heading", "name": "Account Balance" }]
    }
  },
  "businessOutcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member matched the supplied ID",
      "when": { "kind": "visible", "target": { "candidates": [{ "kind": "text", "text": "No member found for that ID." }] } }
    }
  ],
  "runtimeConditions": [
    {
      "code": "SLOW_LOAD",
      "description": "Search results are still loading",
      "classification": "recoverable",
      "when": { "kind": "visible", "target": { "candidates": [{ "kind": "text", "text": "Loading member records. Please wait…" }] } },
      "recovery": { "action": "wait_until_absent", "timeoutMs": 5000, "maxAttempts": 1 }
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The current session cannot view the savings account",
      "classification": "failure",
      "failureCategory": "runtime",
      "when": { "kind": "visible", "target": { "candidates": [{ "kind": "role", "role": "heading", "name": "Access Denied" }] } }
    },
    {
      "code": "SESSION_EXPIRED",
      "description": "The servicing session expired",
      "classification": "failure",
      "failureCategory": "runtime",
      "captureScreenshot": true,
      "when": { "kind": "visible", "target": { "candidates": [{ "kind": "role", "role": "heading", "name": "Session Expired" }] } }
    },
    {
      "code": "UNEXPECTED_DIALOG",
      "description": "An unexpected account notice requires an operator",
      "classification": "intervention",
      "when": { "kind": "visible", "target": { "candidates": [{ "kind": "role", "role": "dialog", "name": "Account notice" }] } }
    }
  ]
}
